ue instanceof Sprite\n    }\n\n    /**\n     * Returns the names of an object's properties.\n     * @param object The object to get the property names from.\n     */\n    //% blockId=typeScriptExtrasObjectKeys\n    //% block=\"keys of %object\"\n    export function objectKeys(object: any): string[] {\n        return Object.keys(object)\n    }\n    /**\n    * Checks whether a value is an array.\n    * @param value The value to check.\n    */\n    //% blockId=typeScriptExtrasIsArray\n    //% block=\"%value is an array\"\n    export function isArray(value: any): boolean {\n        return Array.isArray(value)\n    }\n\n    /**\n     * Checks whether an array contains a value.\n     * @param array The array to search.\n     * @param value The value to look for.\n     */\n    //% blockId=typeScriptExtrasArrayIncludes\n    //% block=\"%array includes %value\"\n    export function arrayIncludes<T>(\n        array: T[],\n        value: T\n    ): boolean {\n        return array.indexOf(value) !== -1\n    }\n    /**\n     * Checks whether a string starts with the specified text.\n     * @param text The string to search.\n     * @param search The text to look for at the beginning.\n     */\n    //% blockId=typeScriptExtrasStringStartsWith\n    //% block=\"%text starts with %search\"\n    export function stringStartsWith(\n        text: string,\n        search: string\n    ): boolean {\n        return text.indexOf(search) === 0\n    }\n    /**\n     * Checks whether a string ends with the specified text.\n     * @param text The string to search.\n     * @param search The text to look for at the end.\n     */\n    //% blockId=typeScriptExtrasStringEndsWith\n    //% block=\"%text ends with %search\"\n    export function stringEndsWith(\n        text: string,\n        search: string\n    ): boolean {\n        if (search.length > text.length) {\n            return false\n        }\n\n        let start = text.length - search.length\n\n        for (let i = 0; i < search.length; i++) {\n            if (text.charAt(start + i) != search.charAt(i)) {\n                return false\n            }\n        }\n\n        return true\n    }\n    /**\n     * Checks whether a string contains the specified text.\n     * @param text The string to search.\n     * @param search The text to look for.\n     */\n    //% blockId=typeScriptExtrasStringIncludes\n    //% block=\"%text includes %search\"\n    export function stringIncludes(\n        text: string,\n        search: string\n    ): boolean {\n        return text.indexOf(search) !== -1\n    }\n    /**\n     * Converts a value to a string.\n     * @param value The value to convert.\n     */\n    //% blockId=typeScriptExtrasString\n    //% block=\"String(%value)\"\n    export function toString(value: any): string {\n        return \"\" + value\n    }\n    /**\n     * Converts a value to a boolean.\n     * @param value The value to convert.\n     */\n    //% blockId=typeScriptExtrasBoolean\n    //% block=\"Boolean(%value)\"\n    export function toBoolean(value: any): boolean {\n        return !!value\n    }\n    /**\n     * Checks whether a number is finite.\n     * @param value The number to check.\n     */\n    //% blockId=typeScriptExtrasIsFinite\n    //% block=\"is finite %value\"\n    export function isFinite(value: number): boolean {\n        return value < Infinity && value > -Infinity\n    }\n    /**\n     * Representing an Infinite value\n     */\n    //% blockId=typeScriptExtrasInfinity\n    //% block=\"infinity\"\n    export function infinity(): number {\n        return Infinity;\n    }\n    /**\n     * Representing a negative Infinite value\n     */\n    //% blockId=typeScriptExtrasNegativeInfinity\n    //% block=\"negative infinity\"\n    export function negativeInfinity(): number {\n        return -Infinity;\n    }\n}","pxt.json":"{\n    \"name\": \"TypeScriptExtras TESTING EXTENSION\",\n    \"description\": \"\",\n    \"dependencies\": {\n        \"device\": \"*\",\n        \"arcade-sprite-util\